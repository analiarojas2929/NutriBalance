# Firebase client configuration (public project identifiers, protected by Firebase Rules)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional server proxy URL. Keep the USDA API key on the server, never in the app bundle.
# The proxy should accept POST /foods/search and forward the request to FoodData Central.
EXPO_PUBLIC_FDC_PROXY_URL=http://localhost:8787
